  "l6" [shape=circle, label="l6"];
  "l7" [shape=circle, label="l7"];
  "l8" [shape=doublecircle, label="l8"];
  "l9" [shape=doublecircle, label="l9"];
  "l10" [shape=doublecircle, label="l10"];
  "l11" [shape=doublecircle, label="l11"];
  "l12" [shape=doublecircle, label="l12"];
  "l13" [shape=doublecircle, label="l13"];
  "l14" [shape=doublecircle, label="l14"];
  "l0" -> "l1" [label="D,L,S,U"];
  "l1" -> "l2" [label="D,L,S,U"];
  "l10" -> "l11" [label="D,L,S,U"];
  "l11" -> "l12" [label="D,L,S,U"];
