  "l13" -> "l14" [label="D,L,S,U"];
  "l2" -> "l3" [label="D,L,S,U"];
  "l3" -> "l4" [label="D,L,S,U"];
  "l4" -> "l5" [label="D,L,S,U"];
  "l5" -> "l6" [label="D,L,S,U"];
  "l6" -> "l7" [label="D,L,S,U"];
  "l7" -> "l8" [label="D,L,S,U"];
  "l8" -> "l9" [label="D,L,S,U"];
  "l9" -> "l10" [label="D,L,S,U"];
}