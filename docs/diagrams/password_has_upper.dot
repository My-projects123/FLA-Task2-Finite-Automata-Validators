digraph "contains U" {
  rankdir=LR;
  node [shape=circle, fontname="Helvetica"];
  edge [fontname="Helvetica"];
  start [shape=point];
  start -> "n";
  "n" [shape=circle, label="n"];
  "y" [shape=doublecircle, label="y"];
  "n" -> "n" [label="D,L,S"];
  "n" -> "y" [label="U"];
  "y" -> "y" [label="D,L,S,U"];
}