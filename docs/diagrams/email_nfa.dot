digraph "E-mail format NFA" {
  rankdir=LR;
  node [shape=circle, fontname="Helvetica"];
  start [shape=point];
  start -> "n0";
  "n0" [shape=circle, label="local start"];
  "n1" [shape=circle, label="in local"];
  "n2" [shape=circle, label="local sep"];
  "n3" [shape=circle, label="after @"];
  "n4" [shape=circle, label="in label"];
  "n5" [shape=circle, label="label hyphen"];
  "n6" [shape=circle, label="after domain ."];
  "n7" [shape=circle, label="TLD len=1"];
  "n8" [shape=doublecircle, label="TLD ok"];
  "n0" -> "n1" [label="D,L"];
  "n1" -> "n1" [label="D,L"];
  "n1" -> "n2" [label="DOT,HY,US"];
  "n1" -> "n3" [label="AT"];
  "n2" -> "n1" [label="D,L"];
  "n3" -> "n4" [label="D,L"];
  "n4" -> "n4" [label="D,L"];
  "n4" -> "n5" [label="HY"];
  "n4" -> "n6" [label="DOT"];
  "n5" -> "n4" [label="D,L"];
  "n5" -> "n5" [label="HY"];
  "n6" -> "n4" [label="D,L"];
  "n6" -> "n7" [label="L"];
  "n7" -> "n8" [label="L"];
  "n8" -> "n6" [label="DOT"];
  "n8" -> "n8" [label="L"];
}