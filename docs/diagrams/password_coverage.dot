digraph "class coverage {U,L,D,S}" {
  rankdir=LR;
  node [shape=circle, fontname="Helvetica"];
  edge [fontname="Helvetica"];
  start [shape=point];
  start -> "none";
  "none" [shape=circle, label="none"];
  "U" [shape=circle, label="U"];
  "L" [shape=circle, label="L"];
  "D" [shape=circle, label="D"];
  "S" [shape=circle, label="S"];
  "UL" [shape=circle, label="UL"];
  "UD" [shape=circle, label="UD"];
  "US" [shape=circle, label="US"];
  "LD" [shape=circle, label="LD"];
  "LS" [shape=circle, label="LS"];
  "DS" [shape=circle, label="DS"];
  "ULD" [shape=circle, label="ULD"];
  "ULS" [shape=circle, label="ULS"];
  "UDS" [shape=circle, label="UDS"];
  "LDS" [shape=circle, label="LDS"];
  "ULDS" [shape=doublecircle, label="ULDS"];
  "D" -> "D" [label="D"];
  "D" -> "DS" [label="S"];
  "D" -> "LD" [label="L"];
  "D" -> "UD" [label="U"];
  "DS" -> "DS" [label="D,S"];
  "DS" -> "LDS" [label="L"];
  "DS" -> "UDS" [label="U"];
  "L" -> "L" [label="L"];
  "L" -> "LD" [label="D"];
  "L" -> "LS" [label="S"];
  "L" -> "UL" [label="U"];
  "LD" -> "LD" [label="D,L"];
  "LD" -> "LDS" [label="S"];
  "LD" -> "ULD" [label="U"];
  "LDS" -> "LDS" [label="D,L,S"];
  "LDS" -> "ULDS" [label="U"];
  "LS" -> "LDS" [label="D"];
  "LS" -> "LS" [label="L,S"];
  "LS" -> "ULS" [label="U"];
  "S" -> "DS" [label="D"];
  "S" -> "LS" [label="L"];
  "S" -> "S" [label="S"];
  "S" -> "US" [label="U"];
  "U" -> "U" [label="U"];
  "U" -> "UD" [label="D"];
  "U" -> "UL" [label="L"];
  "U" -> "US" [label="S"];
  "UD" -> "UD" [label="D,U"];
  "UD" -> "UDS" [label="S"];
  "UD" -> "ULD" [label="L"];
  "UDS" -> "UDS" [label="D,S,U"];
  "UDS" -> "ULDS" [label="L"];
  "UL" -> "UL" [label="L,U"];
  "UL" -> "ULD" [label="D"];
  "UL" -> "ULS" [label="S"];
  "ULD" -> "ULD" [label="D,L,U"];
  "ULD" -> "ULDS" [label="S"];
  "ULDS" -> "ULDS" [label="D,L,S,U"];
  "ULS" -> "ULDS" [label="D"];
  "ULS" -> "ULS" [label="L,S,U"];
  "US" -> "UDS" [label="D"];
  "US" -> "ULS" [label="L"];
  "US" -> "US" [label="S,U"];
  "none" -> "D" [label="D"];
  "none" -> "L" [label="L"];
  "none" -> "S" [label="S"];
  "none" -> "U" [label="U"];
}