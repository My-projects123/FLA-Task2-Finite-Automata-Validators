digraph "ATM PIN (4 or 6 digits)" {
  rankdir=LR;
  node [shape=circle, fontname="Helvetica"];
  edge [fontname="Helvetica"];
  start [shape=point];
  start -> "q0";
  "q0" [shape=circle, label="q0"];
  "q1" [shape=circle, label="q1"];
  "q2" [shape=circle, label="q2"];
  "q3" [shape=circle, label="q3"];
  "q4" [shape=doublecircle, label="q4"];
  "q5" [shape=circle, label="q5"];
  "q6" [shape=doublecircle, label="q6"];
  "q0" -> "q1" [label="D"];
  "q1" -> "q2" [label="D"];
  "q2" -> "q3" [label="D"];
  "q3" -> "q4" [label="D"];
  "q4" -> "q5" [label="D"];
  "q5" -> "q6" [label="D"];
}